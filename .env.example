# Copiar a .env (raíz del proyecto) y completar. NO subir .env a GitHub.

# Token compartido backend <-> chatbot (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Debe ser el MISMO valor que CHATBOT_INTERNAL_TOKEN en el .env de NestJS.
INTERNAL_TOKEN=

# rag = Bedrock + índice local de protocolos | eco = solo devuelve el mensaje (para probar el contrato)
CHATBOT_MODO=eco

AWS_REGION=us-east-2
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_MODEL=us.amazon.nova-lite-v1:0

# Contactos de la sede que el bot puede entregar (validar con la institución)
CONTACTOS_SEDE=Seguridad: +56 32 227 7999 (anexo 999) · Salud (policlínico sede): +56 32 227 7888

# En EC2 NO pongas AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: se usa el rol IAM.
