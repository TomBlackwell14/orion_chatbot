# Copiar a .env (raíz del proyecto) y completar. Backend y chatbot comparten este archivo.

# Token compartido backend <-> chatbot (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))")
INTERNAL_TOKEN=cambiar-por-un-token-largo-y-aleatorio

# rag = Bedrock + pgvector | eco = solo devuelve el mensaje (para probar el contrato)
CHATBOT_MODO=eco

AWS_REGION=us-east-2
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_MODEL=us.amazon.nova-lite-v1:0
# Opcional: leer protocolos desde S3 al indexar
# PROTOCOLOS_S3_URI=s3://mi-bucket/protocolos_completos.txt

DB_HOST=3.18.117.177
DB_PORT=5432
DB_NAME=orion_db
DB_USER=orion_user
DB_PASSWORD=

# En EC2 NO pongas AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: se usa el rol IAM.
